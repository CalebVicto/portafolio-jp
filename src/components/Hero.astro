---
---

<section class="hero" id="inicio">
  <img
    class="hero-bg"
    src="https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=1920&q=80&auto=format&fit=crop"
    alt="Proyector de cine en un cuarto oscuro"
  />
  <div class="hero-overlay"></div>

  <div class="wrap hero-content">
    <span class="eyebrow hero-eyebrow">Portafolio — Producción Audiovisual</span>

    <h1>Jose Peche</h1>

    <p class="hero-copy">
      Fotografía, edición de video y grabación. Cuento historias que merecen ser contadas, desde
      documentales hasta contenido de marca.
    </p>

    <div class="hero-actions">
      <a class="btn-primary" href="#galeria">
        Ver mi portafolio
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="btn-secondary" href="#trabajo">Qué hago</a>
    </div>

    <div class="scroll-hint">
      <span class="eyebrow">Scroll</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.3) brightness(0.6);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0.4) 45%, var(--bg) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-eyebrow {
    color: var(--text-dim);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 9vw, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-copy {
    max-width: 480px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 6px;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 15px 28px;
    border-radius: 999px;
    white-space: nowrap;
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .btn-primary {
    background: var(--text);
    color: var(--bg);
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    border: 1px solid var(--border);
    color: var(--text-dim);
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--text);
  }

  .scroll-hint {
    margin-top: 34px;
  }

  @media (max-width: 560px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
