---
---

<section class="hero" id="inicio">
  <div class="hero-bg-wrap" id="heroBgWrap">
    <img
      class="hero-bg"
      src="https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=1920&q=80&auto=format&fit=crop"
      alt="Proyector de cine en un cuarto oscuro"
    />
  </div>
  <div class="hero-overlay"></div>

  <div class="wrap hero-content" id="heroContent">
    <span class="eyebrow hero-eyebrow hero-anim">Portafolio — Producción Audiovisual</span>

    <h1 class="hero-anim">Jose Peche</h1>

    <p class="hero-copy hero-anim">
      Fotografía, edición de video y grabación. Cuento historias que merecen ser contadas, desde
      documentales hasta contenido de marca.
    </p>

    <div class="hero-actions hero-anim">
      <a class="btn-primary" href="#galeria">
        Ver mi portafolio
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="btn-secondary" href="#trabajo">Qué hago</a>
    </div>

    <a class="scroll-hint hero-anim" href="#trabajo" aria-label="Bajar a la siguiente sección">
      <svg class="scroll-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M12 5v13.5M5.5 13 12 19.5 18.5 13" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    will-change: transform;
  }

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.3) brightness(0.6);
    transform: scale(1.15);
    transform-origin: center;
    animation: hero-kenburns 22s ease-in-out infinite alternate;
    animation-delay: 2.8s;
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1.15) translate(0, 0);
    }
    to {
      transform: scale(1.32) translate(-1.5%, -1.5%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0.4) 45%, var(--bg) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-eyebrow {
    color: var(--text-dim);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 9vw, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-copy {
    max-width: 480px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 6px;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 15px 28px;
    border-radius: 999px;
    white-space: nowrap;
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .btn-primary {
    background: var(--text);
    color: var(--bg);
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    border: 1px solid var(--border);
    color: var(--text-dim);
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--text);
  }

  .scroll-hint {
    margin-top: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    color: var(--text-dim);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .scroll-hint:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--text);
  }

  .scroll-arrow {
    animation: scroll-bounce 1.8s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(6px);
      opacity: 1;
    }
  }

  /* Entrada escalonada: cada .hero-anim empieza invisible y sube al
     entrar la clase .in en el contenedor (disparada cuando el preloader
     termina, ver el <script> más abajo). */
  .hero-anim {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero-content.in .hero-anim {
    opacity: 1;
    transform: none;
  }

  .hero-content.in .hero-anim:nth-child(1) {
    transition-delay: 0.05s;
  }
  .hero-content.in .hero-anim:nth-child(2) {
    transition-delay: 0.15s;
  }
  .hero-content.in .hero-anim:nth-child(3) {
    transition-delay: 0.28s;
  }
  .hero-content.in .hero-anim:nth-child(4) {
    transition-delay: 0.4s;
  }
  .hero-content.in .hero-anim:nth-child(5) {
    transition-delay: 0.52s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-anim {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .scroll-arrow {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const heroContent = document.getElementById('heroContent');
  const heroBgWrap = document.getElementById('heroBgWrap');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Dispara la entrada del hero apenas termina el preloader (o de inmediato
  // si por algún motivo el evento nunca llega).
  let started = false;
  function playIntro() {
    if (started) return;
    started = true;
    heroContent?.classList.add('in');
  }
  window.addEventListener('preloader:done', playIntro, { once: true });
  setTimeout(playIntro, 2600);

  // Parallax sutil del fondo al hacer scroll (en el wrapper, separado del
  // <img> que tiene su propio zoom continuo vía CSS para no pisarse el
  // transform entre sí).
  if (heroBgWrap && !reduceMotion) {
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      heroBgWrap.style.transform = `translateY(${Math.min(y * 0.18, 120)}px)`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
