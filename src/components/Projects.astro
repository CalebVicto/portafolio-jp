---
import { findEntry, videoUrl, posterUrl } from '../lib/video-source';

// Busca en el manifiesto (src/data/video-manifest.json) el archivo cuyo
// nombre contenga `match`. No depende de que public/videos exista en el
// entorno de build (en Vercel no está, se sirve desde afuera).
function findVideo(folderHint: string, match: string) {
  const entry = findEntry(folderHint, match);
  if (!entry) return null;
  return { src: videoUrl(entry), poster: posterUrl(entry) };
}

const documentary = findVideo('certamen de belleza', 'rueda de prensa');
const fiction = findVideo('DISEÑO DE INTERIORES', 'obra san luis');
const commercial = findVideo('automotriz', 'presentaci');

const projects = [
  {
    index: '01',
    title: 'Campaña Documental',
    description: 'Cobertura periodística en vivo de la Rueda de Prensa Avioma 2024, dentro de la campaña del Miss Intercultural Turismo.',
    tags: ['Cobertura', 'Edición'],
    media: documentary,
  },
  {
    index: '02',
    title: 'Cortometraje de Ficción',
    description: 'Pieza narrada con guion propio: recorrido con voz en off por la obra San Luis — Las Leñas.',
    tags: ['Narración', 'Guion'],
    media: fiction,
  },
  {
    index: '03',
    title: 'Edición Comercial',
    description: 'Video de presentación de producto para marca de tapicería automotriz. Ritmo publicitario y montaje ágil.',
    tags: ['Montaje', 'Producto'],
    media: commercial,
  },
];
---

<section class="projects" id="trabajo">
  <div class="wrap projects-head">
    <h2>Servicios</h2>
    <span class="eyebrow">01 // Selected Works</span>
  </div>

  <div class="wrap">
    <div class="projects-grid">
      {
        projects.map((p) => (
          <article class="project-item">
            {p.media ? (
              <button class="card" type="button" data-src={p.media.src} data-title={p.title}>
                <img class="card-thumb" src={p.media.poster} alt={p.title} loading="lazy" />
                <span class="card-play" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </button>
            ) : (
              <div class="card card-fallback" />
            )}

            <div class="project-item-text">
              <span class="eyebrow index">{p.index}.</span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <div class="tags">
                {p.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 130px 0 60px;
  }

  .projects-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 44px;
  }

  .projects-head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .project-item {
    display: flex;
    flex-direction: column;
  }

  .project-item .card-thumb {
    aspect-ratio: 4 / 3;
  }

  .card-fallback {
    aspect-ratio: 4 / 3;
    background: var(--bg-alt);
  }

  .project-item-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
  }

  .index {
    color: var(--text-faint);
  }

  .project-item h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.15;
  }

  .project-item p {
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }

  @media (max-width: 860px) {
    .projects {
      padding: 100px 0 40px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
