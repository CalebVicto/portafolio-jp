---
const services = [
  {
    index: '01',
    title: 'Fotografía',
    description: 'Sesiones para eventos, retratos y contenido de marca: composición, iluminación y corrección de color pensadas para cada plataforma.',
    tags: ['Eventos', 'Retrato'],
  },
  {
    index: '02',
    title: 'Edición de Video',
    description: 'Montaje y posproducción con ritmo narrativo propio: corrección de color, diseño sonoro y motion graphics.',
    tags: ['Montaje', 'Color'],
  },
  {
    index: '03',
    title: 'Grabación',
    description: 'Cobertura en vivo con equipo profesional: eventos, entrevistas y rodajes de marca o ficción, en Lima y todo el Perú.',
    tags: ['Rodaje', 'Cobertura'],
  },
];
---

<section class="projects" id="trabajo">
  <div class="wrap projects-head reveal">
    <h2>Servicios</h2>
    <span class="eyebrow">01 // What I Do</span>
  </div>

  <div class="wrap">
    <div class="projects-grid">
      {
        services.map((s, i) => (
          <article class="service-item reveal" data-reveal-delay={i * 120}>
            <span class="service-index">{s.index}</span>
            <div class="service-rule" />
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            <div class="tags">
              {s.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 130px 0 100px;
  }

  .projects-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 60px;
  }

  .projects-head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .service-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .service-index {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .service-rule {
    height: 1px;
    background: var(--border);
    transition: background 0.3s ease;
  }

  .service-item:hover .service-rule {
    background: rgba(255, 255, 255, 0.35);
  }

  .service-item h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(21px, 2vw, 26px);
    line-height: 1.2;
    margin-top: 4px;
  }

  .service-item p {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.7;
    max-width: 340px;
  }

  .tags {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .projects {
      padding: 100px 0 60px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .service-item p {
      max-width: none;
    }
  }
</style>
