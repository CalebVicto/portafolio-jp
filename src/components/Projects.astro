---
const project1 = {
  image:
    'https://images.unsplash.com/photo-1531123897727-8f129e1688ce?w=1200&q=80&auto=format&fit=crop',
  alt: 'Retrato de mujer en comunidad rural africana',
};

const project2 = {
  image:
    'https://images.unsplash.com/photo-1519692933481-e162a57d6721?w=1200&q=80&auto=format&fit=crop',
  alt: 'Calle lluviosa por la noche con una persona bajo un paraguas',
};

const project3 = {
  image:
    'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1920&q=80&auto=format&fit=crop',
  alt: 'Coche de carreras en pista mojada bajo la lluvia',
};
---

<section class="projects" id="trabajo">
  <div class="wrap projects-head">
    <h2>Proyectos Destacados</h2>
    <span class="eyebrow">01 // Selected Works</span>
  </div>

  <div class="wrap">
    <!-- 01 -->
    <article class="project project-01">
      <div class="project-text">
        <span class="eyebrow index">01.</span>
        <h3>Campaña<br />Documental</h3>
        <p>
          Un viaje visual a través de las comunidades rurales en África subsahariana,
          documentando la resiliencia y el espíritu humano ante la adversidad.
        </p>
        <div class="tags">
          <span class="tag">Dirección</span>
          <span class="tag">Edición</span>
        </div>
      </div>
      <div class="project-media">
        <img src={project1.image} alt={project1.alt} loading="lazy" />
      </div>
    </article>

    <!-- 02 -->
    <article class="project project-02">
      <div class="project-media">
        <img src={project2.image} alt={project2.alt} loading="lazy" />
      </div>
      <div class="project-text">
        <span class="eyebrow index">02.</span>
        <h3>Cortometraje<br />de Ficción</h3>
        <p>
          Exploración narrativa sobre la soledad en las grandes metrópolis. Premiado en
          múltiples festivales europeos de cine independiente.
        </p>
        <div class="tags">
          <span class="tag">Producción</span>
          <span class="tag">Guion</span>
        </div>
      </div>
    </article>

    <!-- 03 -->
    <article class="project project-03">
      <div class="project-03-head">
        <span class="eyebrow index">03.</span>
        <h3>Edición Comercial</h3>
      </div>
      <div class="project-media wide">
        <img src={project3.image} alt={project3.alt} loading="lazy" />
      </div>
      <div class="project-03-foot">
        <p>
          Campaña publicitaria de alcance nacional para marca de automoción. Ritmo frenético,
          diseño sonoro inmersivo y corrección de color agresiva.
        </p>
        <div class="tags">
          <span class="tag">Montaje</span>
          <span class="tag">Color</span>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .projects {
    padding: 140px 0 60px;
  }

  .projects-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 90px;
  }

  .projects-head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 130px;
  }

  .project-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .index {
    color: var(--text-faint);
  }

  .project h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.08;
  }

  .project p {
    max-width: 380px;
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.7;
  }

  .tags {
    display: flex;
    gap: 10px;
    margin-top: 8px;
  }

  .project-media img {
    width: 100%;
    height: 460px;
    object-fit: cover;
    filter: grayscale(0.1) brightness(0.85);
  }

  .project-02 .project-text {
    align-items: flex-end;
    text-align: right;
  }

  .project-02 p {
    margin-left: auto;
  }

  .project-03 {
    display: block;
    margin-bottom: 60px;
  }

  .project-03-head {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 14px;
    margin-bottom: 30px;
  }

  .project-03-head h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.8vw, 30px);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .project-media.wide img {
    height: 520px;
  }

  .project-03-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 28px;
  }

  .project-03-foot p {
    max-width: 520px;
  }

  @media (max-width: 860px) {
    .project,
    .project-02 {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .project-02 .project-media {
      order: -1;
    }

    .project-02 .project-text {
      align-items: flex-start;
      text-align: left;
    }

    .project-02 p {
      margin-left: 0;
    }

    .project-media img {
      height: 320px;
    }

    .project-media.wide img {
      height: 320px;
    }

    .project-03-head {
      justify-content: flex-start;
    }

    .project-03-foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
