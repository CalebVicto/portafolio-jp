---
const columns = [
  {
    title: 'Workflow',
    lines: ['DaVinci Resolve Studio', 'Adobe Premiere Pro'],
  },
  {
    title: 'Cámaras',
    lines: ['Arri Alexa Mini', 'Sony FX6'],
  },
  {
    title: 'Estudio',
    lines: ['Madrid, España', 'Disponible global'],
  },
  {
    title: 'Contacto',
    lines: ['hola@josepeche.com', '+34 600 000 000'],
  },
];
---

<footer class="site-footer" id="contacto">
  <div class="wrap footer-grid">
    {
      columns.map((col) => (
        <div class="footer-col">
          <span class="eyebrow">{col.title}</span>
          {col.lines.map((line) => (
            <span class="footer-line">{line}</span>
          ))}
        </div>
      ))
    }
  </div>

  <div class="wrap footer-brand">
    <div>
      <span class="eyebrow">Production &amp; Editing</span>
      <p class="brand-name">Jose Peche</p>
    </div>
    <div class="socials">
      <a href="#" aria-label="Vimeo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <polygon points="5 3 19 12 5 21 5 3" />
        </svg>
      </a>
      <a href="#" aria-label="Instagram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a href="mailto:hola@josepeche.com" aria-label="Email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3 7l9 6 9-6" />
        </svg>
      </a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span>© 2026 Jose Peche. All rights reserved.</span>
    <span>Built for cinema.</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-top: 70px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    padding-bottom: 70px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-line {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }

  .footer-brand {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 46px 0;
    border-top: 1px solid var(--border);
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 4vw, 40px);
    margin-top: 8px;
  }

  .socials {
    display: flex;
    gap: 20px;
  }

  .socials a {
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  .socials a:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 34px;
    }

    .footer-brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
