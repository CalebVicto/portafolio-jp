# URL pública (sin slash final) del bucket/CDN donde subiste public/videos
# (por ejemplo Cloudflare R2 o Bunny Storage). Debe contener la misma
# estructura de carpetas: EVENTOS/, DISEÑO DE INTERIORES/, etc.
#
# Si se deja vacía o sin definir, el sitio sirve los videos localmente desde
# public/videos (útil en desarrollo).
PUBLIC_VIDEO_BASE_URL=https://videos.tudominio.com
