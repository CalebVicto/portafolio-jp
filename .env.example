# URL base pública (sin slash final) desde donde se sirven los videos.
#
# Con GitHub Releases (gratis, sin tarjeta) el formato es:
#   https://github.com/<owner>/<repo>/releases/download/<tag>
# ej: https://github.com/josepeche/josepeche-media/releases/download/media-v1
#
# Los nombres de archivo "limpios" (sin tildes/espacios) que corresponden a
# cada video están en src/data/video-manifest.json.
#
# Si se deja vacía o sin definir, el sitio sirve los videos localmente desde
# public/videos (útil en desarrollo).
PUBLIC_VIDEO_BASE_URL=https://github.com/tu-usuario/tu-repo-media/releases/download/media-v1
